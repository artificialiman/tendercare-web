# Same Supabase project as tendercare-teacher/tendercare-portal — copy its
# values here. This app is fully static (adapter-static) with no server
# routes, so only the PUBLIC_-prefixed anon client is ever used here —
# never add a service-role key to this app, there's no server to keep it
# secret on.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
